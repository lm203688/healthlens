{
  "name": "HealthLens",
  "description": "HealthLens 整合医学健康推演 Agent：八轴稳态框架（A–H）+ 六公理内核，融合生物标志物、中医古籍与可穿戴数据。健康参考工具，非医疗器械。",
  "url": "https://healthlens.cc/api/v1",
  "protocolVersion": "1.0.1",
  "version": "0.37.0",
  "provider": {
    "organization": "HealthLens",
    "url": "https://github.com/lm203688/healthlens"
  },
  "documentationUrl": "https://github.com/lm203688/healthlens/blob/main/README.md",
  "supportsAuthenticatedExtendedCard": false,
  "signing_key": "ES256:HEALTHLENS_PROD_KEY_REF",
  "jws_signature": "TODO:sign_at_deploy",
  "capabilities": {
    "STREAMING": false,
    "PUSH_NOTIFICATIONS": false,
    "EXTENDED_AGENT_CARD": false,
    "STATE_TRANSITION_HISTORY": false,
    "LIST_TASKS": true,
    "EXTENSIONS": [
      {
        "uri": "https://github.com/lm203688/healthlens#mcp",
        "description": "MCP JSON-RPC 2.0（2026-07-28），端点 POST /api/v1/mcp，工具清单 GET /api/v1/mcp/tools。",
        "specs": [
          {
            "spec": "https://modelcontextprotocol.io/specification/2026-07-28",
            "version": "2026-07-28"
          }
        ]
      },
      {
        "uri": "https://google.github.io/A2A/specification/v1.0.1/",
        "description": "A2A v1.0.1：SendMessage/ListTasks/GetTask/CancelTask JSON-RPC（POST /a2a）。",
        "verbs": [
          "SendMessage",
          "ListTasks",
          "GetTask",
          "CancelTask"
        ],
        "specs": [
          {
            "spec": "https://google.github.io/A2A/specification/v1.0.1/",
            "version": "1.0.1"
          }
        ]
      }
    ]
  },
  "conformanceNote": "A2A v1.0.1 端点已实现（SendMessage/ListTasks/GetTask/CancelTask via POST /a2a JSON-RPC）；Agent Card + JWS 签名（KMS）。STATE_TRANSITION_HISTORY 未实现。并行接口：MCP JSON-RPC 2.0 + skills[].interfaceUrl REST。",
  "defaultInputModes": [
    "text/plain",
    "application/json"
  ],
  "defaultOutputModes": [
    "application/json",
    "text/plain"
  ],
  "securitySchemes": {
    "bearerAuth": {
      "type": "http",
      "scheme": "bearer",
      "bearerFormat": "JWT"
    }
  },
  "supportedInterfaces": [
    {
      "url": "https://healthlens.cc/api/v1",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0.1"
    }
  ],
  "skills": [
    {
      "id": "health-check",
      "name": "服务健康检查",
      "description": "返回服务健康状态、版本号与分层配置。无需认证。",
      "tags": [
        "ops",
        "health",
        "discovery"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/health",
      "securityRequirements": []
    },
    {
      "id": "eight-axis-assessment",
      "name": "八轴稳态评估",
      "description": "基于生物标志物/可穿戴/自评计算八轴（A–H）评分。需登录。",
      "tags": [
        "assessment",
        "biomarkers",
        "core"
      ],
      "examples": [
        "评估我的八轴健康状态，我的空腹血糖 6.4，HbA1c 5.4，HRV-RMSSD 28"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/axes/assess",
      "securityRequirements": [
        {
          "bearerAuth": []
        }
      ]
    },
    {
      "id": "axis-meta",
      "name": "八轴定义与机制说明",
      "description": "返回八轴框架元定义、六公理、每轴机制解释与可干预杠杆。不含个人数据，可公开调用。",
      "tags": [
        "knowledge",
        "framework",
        "public"
      ],
      "examples": [
        "解释 HealthLens 八轴框架是什么"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/axes/meta",
      "securityRequirements": []
    },
    {
      "id": "axis-evidence",
      "name": "案例证据检索",
      "description": "按 case_id 返回证据案例（DOI / 等级 / 轴归属）。案例库 120 条：7 Crossref 验真 + 8 古籍 + 14 未验证 + 91 合成。",
      "tags": [
        "evidence",
        "doi",
        "public"
      ],
      "examples": [
        "CASE-006 的证据来源是什么"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/axes/evidence/{case_id}",
      "securityRequirements": []
    },
    {
      "id": "bio-age",
      "name": "生物学年龄偏移（H 轴）",
      "description": "计算生物年龄偏移，对标 PhenoAge（Liu 2018）。SI 单位。需登录。",
      "tags": [
        "aging",
        "phenoage",
        "biomarkers"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/axes/bioage",
      "securityRequirements": [
        {
          "bearerAuth": []
        }
      ]
    },
    {
      "id": "causal-structure",
      "name": "因果结构查询",
      "description": "八轴 SCM：8 节点 / 5 边 / 7 杠杆 + E-value。可公开调用。",
      "tags": [
        "causal",
        "scm",
        "e-value",
        "public"
      ],
      "inputModes": [
        "text/plain"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/causal/scm",
      "securityRequirements": []
    },
    {
      "id": "causal-scenario",
      "name": "反事实干预推演",
      "description": "给定八轴分数与干预，推演反事实效应 + E-value + bootstrap 区间。in-silico。需登录。",
      "tags": [
        "causal",
        "counterfactual",
        "simulation",
        "personalized"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/causal/report",
      "securityRequirements": [
        {
          "bearerAuth": []
        }
      ]
    },
    {
      "id": "knowledge-search",
      "name": "中医古籍知识检索",
      "description": "检索中医知识库（TCM-MKG 图谱 + 古籍切片）。",
      "tags": [
        "tcm",
        "knowledge",
        "herbs",
        "public"
      ],
      "inputModes": [
        "text/plain",
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/knowledge/food-therapy/search",
      "securityRequirements": []
    },
    {
      "id": "food-therapy-recommend",
      "name": "食疗方案推荐",
      "description": "基于体质与目标推荐非药物食疗。经法域感知 claims 引擎过滤。需登录。",
      "tags": [
        "tcm",
        "diet",
        "non-pharma",
        "personalized"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/knowledge/food-therapy/recommend",
      "securityRequirements": [
        {
          "bearerAuth": []
        }
      ]
    },
    {
      "id": "frequency-prescription",
      "name": "放松音频体验处方",
      "description": "放松音频体验方案。非治疗，not_clinical 标注。仅关联音频素材。需登录。",
      "tags": [
        "audio",
        "relaxation",
        "wellness",
        "personalized"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/frequency/prescription",
      "securityRequirements": [
        {
          "bearerAuth": []
        }
      ]
    },
    {
      "id": "mcp-tools",
      "name": "MCP 工具接口（JSON-RPC 2.0）",
      "description": "MCP JSON-RPC 2.0 暴露分层工具。L1/L2 公开，L3 服务端开关。",
      "tags": [
        "mcp",
        "protocol",
        "tools",
        "interoperability"
      ],
      "inputModes": [
        "application/json"
      ],
      "outputModes": [
        "application/json"
      ],
      "interfaceUrl": "https://healthlens.cc/api/v1/mcp/tools",
      "securityRequirements": []
    }
  ]
}
