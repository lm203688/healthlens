{
  "project_name": "HealthLens",
  "project_url": "https://healthlens.cc",
  "deployment": {
    "_comment_incident_20260804": "重大发现：原 ssh_host=root@150.158.119.19 是 AIShield 项目的服务器，不是 HealthLens 的。该机器 nginx 只有 aishield 的 vhost，带 Host:healthlens.cc 直连会返回 AIShield 首页。HealthLens 实际从未部署到任何服务器。已将 ssh_host 置空，使部署阶段显式报「未配置」而不是静默指向他人服务器。",
    "deploy_method": "scp",
    "ssh_host": "",
    "verified_at": null,
    "known_foreign_hosts": {
      "150.158.119.19": "AIShield (aishield.tools)"
    },
    "remote_content_path": "/opt/healthlens/web/static/knowledge",
    "remote_sitemap_path": "/opt/healthlens/web/static/sitemap.xml",
    "sitemap_url": "https://healthlens.cc/sitemap.xml",
    "_comment_dry_run": "此前 config 里没有 dry_run 键，而代码用 .get('dry_run', True) 兜底，导致部署阶段永久 dry-run，从未真正上线过任何文件。现在显式声明。要真实部署请改为 false 并确保 ssh_host 已填且 SSH 免密可用。",
    "dry_run": true,
    "verify_after_deploy": true,
    "rollback_on_verify_fail": true
  },
  "alerting": {
    "enabled": true,
    "cooldown_seconds": 14400,
    "_comment": "告警通道：本地文件（必选）+ 控制台（醒目输出）。如需webhook，添加enabled=true的真实地址。",
    "webhooks": []
  },
  "database": {
    "_comment": "后端数据库连接。优先级：环境变量 DATABASE_URL > 本地Docker PostgreSQL > SQLite fallback。",
    "url": "",
    "_comment_url": "填入 PostgreSQL 连接串，如 postgresql://user:pass@host:5432/healthlens。留空则尝试环境变量 DATABASE_URL 或本地Docker。",
    "fallback_sqlite": true,
    "_comment_sqlite": "当 PostgreSQL 不可用时，自动降级到 SQLite 本地数据库（适合开发/免费部署）。"
  },
  "execution": {
    "_comment": "调度器的重试与超时策略。此前无任何重试：脚本失败即整条线中断且无人知晓。",
    "max_retries": 2,
    "retry_delay_seconds": 30,
    "script_timeout_seconds": 300,
    "fail_fast_on_phase_error": true,
    "auto_heal_enabled": true
  },
  "watchdog": {
