# ============================================================
# 安全第一：以下文件绝对不能进仓库
# 已确认本地存在真实密钥：
#   healthlens/.env            含 XUNHU_SECRET（虎皮椒支付）、JWT_SECRET_KEY
#   healthlens/nginx/ssl/*.key SSL 私钥
# 一旦推送到 GitHub，即使后续删除，历史记录里仍可被检索到。
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
!**/public*.key
id_rsa*
*.p12
*.pfx
secrets.json
credentials.json

# ============================================================
# Agent 工作区 —— 含真实密钥，严禁入库
# .workbuddy/cache/ 内有：
#   ecs_deploy_key          ECS 部署私钥（ED25519，免密 sudo）
#   ecs_deploy_key.pub
#   cf_tokens.json / .txt   Cloudflare Pages 令牌（可部署 healthlens 项目）
# 2026-08-29 实测这些目录此前并未被 .gitignore 覆盖，
# git add -A 会把密钥直接推上 GitHub（删文件也删不掉历史），故在此显式拦截。
# ============================================================
.workbuddy/
.wrangler/
.opencode/

# 一次性构建目录：phase_6 每次构建生成 dist_build_<ts>，可随时重建，不入库
auto-pipeline/dist_build*/
# 部署转正后的回滚快照（cf_pages_deploy.py 的 promote() 生成，仅保留最近 3 份）
auto-pipeline/dist_prev*/

# ============================================================
# 大体积资产：不进仓库（中医语料 247MB，且自带独立 .git）
# 需要时从原始来源单独同步，不占用 GitHub 配额
# ============================================================
中医/
*.pdf
*.ttf
*.woff
*.woff2

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
develop-eggs/
dist/
!auto-pipeline/dist/          # 构建产物需要被 Actions 部署，例外放行
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ============================================================
# 本地自测与运行时产物
# ============================================================
.selftest/
.selftest_logs/
.probe/
tools_size_check.py
celerybeat-schedule*
*.sqlite
*.sqlite3
*.db

# ============================================================
# 日志与临时状态（保留目录结构，不保留内容）
# ============================================================
*.log
auto-pipeline/logs/*
!auto-pipeline/logs/.gitkeep
auto-pipeline/alerts/*.jsonl
auto-pipeline/backups/

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 前端
# ============================================================
node_modules/
.next/
.cache/

# ============================================================
# 内层应用仓库（healthlens/ 子目录自带 .git + 后端代码）
# 排除后端与嵌套 .git，仅保留前端 SPA（站点构建必需 index.html）
# 这样父仓库 git add 不会把 healthlens/ 当成 submodule
# ============================================================
healthlens/**
!healthlens/frontend
!healthlens/frontend/**
